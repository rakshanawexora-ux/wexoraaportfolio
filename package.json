{
  "name": "wexoraa-portfolio",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "npm run check:projects && next build",
    "start": "node scripts/serve.mjs",
    "format": "prettier --write src scripts next.config.mjs README.md docs",
    "format:check": "prettier --check src scripts next.config.mjs README.md docs",
    "check:projects": "node scripts/check-projects.mjs"
  },
  "dependencies": {
    "lenis": "1.3.27",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "prettier": "^3.6.0"
  }
}
